---
import Layout from "../layouts/Layout.astro";
import { site } from "../lib/site";
import Icon from "../components/Icon.astro";
import CodeBlock from "../components/CodeBlock.astro";
import SearchPreview from "../components/SearchPreview";
import { search } from "thai-address-sdk";
const previewResults = search("อยูทยา", { limit: 3 });
const snippet = `import { search } from "thai-address-sdk";

const [address] = search("อยูทยา", {
  levels: ["province"],
  limit: 1,
});

console.log(address?.province.provinceNameTh);
// "พระนครศรีอยุธยา"`;
---

<Layout>
  <section class="hero container">
    <div class="hero-copy">
      <div class="release-tag">
        <span>v{site.version}</span> Open source · TypeScript
      </div><h1>
        ที่อยู่ไทย<br /><span>จัดการได้</span><br />ในไม่กี่บรรทัด.
      </h1><p class="hero-description">
        Thai Address SDK คือไลบรารีที่อยู่ไทยสำหรับ JavaScript และ TypeScript<br
          class="desktop-break"
        /> ค้นหาจังหวัด อำเภอ ตำบล และรหัสไปรษณีย์ ไม่ต้องมี API key
      </p><div class="hero-actions">
        <a class="button primary" href="/getting-started/"
          ><Icon name="code" />เริ่มใช้งาน</a
        ><a class="button secondary" href="/playground/">ลอง Playground</a>
      </div><button
        class="install-command"
        type="button"
        data-copy="npm install thai-address-sdk"
        aria-label="คัดลอกคำสั่ง npm install thai-address-sdk"
        ><span class="prompt" aria-hidden="true">$</span><code
          >npm install thai-address-sdk</code
        ><Icon name="copy" size={16} /></button
      ><p class="hero-note">
        JavaScript & TypeScript <span>·</span> Node.js & Browser
      </p>
    </div>
    <div class="hero-demo-wrap">
      <div class="demo-caption">
        <span class="caption-line"></span>จากคำที่พิมพ์ สู่ที่อยู่ที่ใช่
      </div><SearchPreview initialResults={previewResults} client:idle /><div
        class="demo-under-note"
      >
        <Icon name="check" size={16} /> คำค้นอยู่ในแอปของคุณ ไม่มีคำขอไปยัง API
      </div>
    </div>
  </section>
  <div class="facts-strip">
    <div class="container facts-inner">
      <div><strong>77</strong><span>จังหวัดทั่วประเทศไทย</span></div><div>
        <strong>TH / EN</strong><span>ค้นหาได้สองภาษา</span>
      </div><div>
        <strong>Offline</strong><span>ข้อมูลพร้อมอยู่ในแพ็กเกจ</span>
      </div><div><strong>MIT</strong><span>ใช้และต่อยอดได้</span></div>
    </div>
  </div>
  <section class="container section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">BUILT FOR YOUR ADDRESS FORM</p><h2>
          เรื่องที่อยู่ ให้ไลบรารีช่วย
        </h2>
      </div><p>จากช่องค้นหาเล็ก ๆ<br />ถึงฟอร์มที่อยู่ครบชุด</p>
    </div><div class="feature-grid">
      <article class="feature">
        <div class="feature-icon"><Icon name="search" size={24} /></div><h3>
          พิมพ์ใกล้เคียง ก็หาเจอ
        </h3><p>
          ค้นหาชื่อไทย อังกฤษ และชื่อเรียกทั่วไป พร้อม fuzzy search
          ช่วยหาคำสะกดใกล้เคียง
        </p><a href="/playground/?mode=search">ลองค้นหาที่อยู่</a>
      </article><article class="feature">
        <div class="feature-icon"><Icon name="layers" size={24} /></div><h3>
          เลือกต่อกันได้ครบทุกระดับ
        </h3><p>
          เชื่อมจังหวัด อำเภอ และตำบลให้สัมพันธ์กัน
          แล้วดึงรหัสไปรษณีย์จากตำบลที่เลือก
        </p><a href="/playground/?mode=dropdown">ลองเลือกพื้นที่</a>
      </article><article class="feature">
        <div class="feature-icon"><Icon name="code" size={24} /></div><h3>
          ข้อความเดียว เป็นข้อมูลพร้อมใช้
        </h3><p>
          วิเคราะห์ชื่อพื้นที่หลายส่วน แสดงคำที่แก้ และจัดรูปแบบเป็นไทยเต็ม
          ไทยย่อ หรืออังกฤษ
        </p><a href="/playground/?mode=normalize">ลองจัดรูปแบบ</a>
      </article>
    </div>
  </section>
  <section class="code-section">
    <div class="container code-feature">
      <div>
        <p class="eyebrow">SMALL API. USEFUL RESULTS.</p><h2>
          เริ่มจากหนึ่ง import<br />แล้วลองได้เลย
        </h2><p>
          ฟังก์ชันทำงานแบบ synchronous<br />พร้อม TypeScript types
          และข้อมูลในตัว
        </p><a class="button secondary" href="/getting-started/"
          >อ่านคู่มือเริ่มต้น</a
        >
      </div><CodeBlock code={snippet} label="your-app.ts" />
    </div>
  </section>
  <section class="container section">
    <div class="section-heading">
      <div>
        <p class="eyebrow">MAKE IT YOURS</p><h2>ต่อเข้ากับแอปที่คุณใช้</h2>
      </div><a class="text-link" href="/examples/">ดูตัวอย่างทั้งหมด</a>
    </div><div class="recipe-grid">
      <a class="recipe" href="/examples/#autocomplete"
        ><span class="recipe-label">REACT</span><h3>
          ช่องค้นหา Autocomplete
        </h3><p>คำแนะนำขณะพิมพ์ พร้อมการเลือกด้วยคีย์บอร์ด</p><span class="mono"
          >search(query)</span
        ></a
      ><a class="recipe" href="/examples/#dropdown"
        ><span class="recipe-label">REACT</span><h3>
          ฟอร์มจังหวัด–อำเภอ–ตำบล
        </h3><p>ค่าที่สัมพันธ์กัน พร้อมรหัสไปรษณีย์</p><span class="mono"
          >getSubdistricts(options)</span
        ></a
      ><a class="recipe" href="/examples/#nextjs"
        ><span class="recipe-label">NEXT.JS</span><h3>
          โหลดข้อมูลเมื่อพร้อมใช้
        </h3><p>ตัวอย่าง Client Component และ dynamic import</p><span
          class="mono">import("thai-address-sdk")</span
        ></a
      >
    </div>
  </section>
  <section
    class="container section sdk-summary"
    aria-labelledby="sdk-summary-title"
  >
    <p class="eyebrow">THAI ADDRESS LIBRARY</p><h2 id="sdk-summary-title">
      เลือกฟังก์ชันให้ตรงกับงานที่อยู่ไทย
    </h2>
    <p>
      ใช้ <code>search()</code> สำหรับ autocomplete, <code
        >normalizeAddress()</code
      > สำหรับข้อความที่มีชื่อพื้นที่หลายส่วน และ <code>getProvinces()</code>, <code
        >getDistricts()</code
      >, <code>getSubdistricts()</code> สำหรับ dropdown ข้อมูลอยู่ในแพ็กเกจและทุกฟังก์ชันทำงานแบบ
      synchronous
    </p>
    <p>
      SDK v{site.version} ใช้ได้ทั้ง ESM และ CommonJS รองรับ Node.js 18+ และ browser
      ผ่าน bundler โค้ดและข้อมูลต้นทางเผยแพร่ภายใต้ MIT License โดยชุดข้อมูลเป็น snapshot
      ที่ไม่ได้อัปเดตอัตโนมัติ
    </p>
    <div class="answer-links">
      <a href="/faq/">คำถามที่พบบ่อยเกี่ยวกับการใช้ SDK</a><a href="/api/#data"
        >ตรวจสอบแหล่งข้อมูลและ License</a
      ><a href={site.npm}>แพ็กเกจ thai-address-sdk บน npm</a>
    </div>
    <p class="reviewed-note">
      ทบทวนเนื้อหา <time datetime="2026-10-05">2026-10-05</time> · ผู้ดูแล <a
        href={site.authorUrl}>{site.author}</a
      >
    </p>
  </section>
  <section class="container closing-note">
    <Icon name="book" size={24} /><p>
      <strong>รู้ขอบเขตก่อนนำไปใช้</strong> SDK จัดการจังหวัด อำเภอ ตำบล และรหัสไปรษณีย์
      ยังไม่แยกบ้านเลขที่ ถนน ซอย หรือพิกัด
    </p><a href="/api/#limitations">อ่านข้อจำกัด</a>
  </section>
</Layout>

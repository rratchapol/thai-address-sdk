---
import Layout from "./Layout.astro";
import { getPage, site } from "../lib/site";
import Breadcrumbs from "../components/Breadcrumbs.astro";
interface Props {
  title: string;
  description: string;
  eyebrow: string;
  toc: { id: string; label: string }[];
}
const { title, description, eyebrow, toc } = Astro.props;
const pathname = Astro.url.pathname;
const page = getPage(pathname);
---

<Layout title={title} description={description}>
  <div class="container docs-layout">
    <aside class="docs-sidebar">
      <p class="sidebar-label">DOCUMENTATION</p><nav aria-label="เอกสาร">
        <a
          href="/getting-started/"
          aria-current={pathname === "/getting-started/" ? "page" : undefined}
          >เริ่มใช้งาน</a
        ><a
          href="/examples/"
          aria-current={pathname === "/examples/" ? "page" : undefined}
          >ตัวอย่างใช้งาน</a
        ><a
          href="/api/"
          aria-current={pathname === "/api/" ? "page" : undefined}
          >API Reference</a
        ><a href="/playground/">Playground</a><a
          href="/faq/"
          aria-current={pathname === "/faq/" ? "page" : undefined}
          >คำถามที่พบบ่อย</a
        >
      </nav><p class="sidebar-label toc-label">ในหน้านี้</p><nav
        class="toc"
        aria-label="สารบัญหน้านี้"
      >
        {toc.map((item) => <a href={`#${item.id}`}>{item.label}</a>)}
      </nav><div class="sidebar-version">
        <span class="mono">v{site.version}</span><span
          >เอกสารตรงกับเวอร์ชันที่ใช้ในเดโม</span
        >
      </div>
    </aside>
    <article class="docs-article">
      <Breadcrumbs />
      <header class="docs-heading">
        <p class="eyebrow">{eyebrow}</p><h1>{title}</h1><p>{description}</p><p
          class="reviewed-note"
        >
          ตรวจทานกับ SDK v{site.version} · <time datetime={page?.reviewed}
            >{page?.reviewed}</time
          > · <a href={site.authorUrl}>ผู้ดูแล {site.author}</a>
        </p>
      </header><slot />
    </article>
  </div>
</Layout>
